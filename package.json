{
  "name": "video-lula-condenacoes",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "preview": "vite --config preview/vite.config.ts",
    "build:preview": "vite build --config preview/vite.config.ts",
    "render": "remotion render src/index.ts",
    "audio": "python3 scripts/gerar_audio.py",
    "imagens": "node scripts/baixar-imagens.mjs",
    "sfx": "bash scripts/gerar-sfx.sh",
    "typecheck": "tsc --noEmit",
    "pptx": "node apresentacao/gerar-pptx.cjs",
    "audio:5s": "python3 scripts/gerar_audio.py --video 5s",
    "render:5s": "remotion render src/index.ts Projeto5S out/Projeto-5S.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/player": "4.0.535",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "pptxgenjs": "^3.12.0",
    "react-icons": "^5.4.0",
    "sharp": "^0.33.5",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
