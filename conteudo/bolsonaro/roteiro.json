        { "tipo": "contador", "de": 0, "ate": 37, "unidade": "indiciados pela PF", "rotulo": "Bolsonaro + 36", "em": "indiciou", "posicao": "alto" },
        { "tipo": "pessoa", "imagem": "gonet", "nome": "Paulo Gonet", "cargo": "Procurador-Geral da República", "em": "Procuradoria", "posicao": "alto" },
