      ]
    },
    {
      "id": "domiciliar",
      "texto": "Antes disso, em agosto de 2025, ele já estava em prisão domiciliar, por descumprir medidas impostas pelo STF, como a proibição de usar redes sociais.",
      "fundo": "bolsonaro",
      "fontes": ["STF — decisão de 04/08/2025", "Agência Brasil"],
